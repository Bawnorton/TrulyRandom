{
  "schemaVersion": 1,
  "id": "trulyrandom",
  "version": "${version}",
  "name": "trulyrandom",
  "description": "Randomise various aspects of the game",
  "authors": [
    "Bawnorton"
  ],
  "contact": {
    "homepage": "https://github.com/Bawnorton/TrulyRandom",
    "sources": "https://github.com/Bawnorton/TrulyRandom"
  },
  "license": "MIT",
  "icon": "assets/trulyrandom/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.bawnorton.trulyrandom.TrulyRandom"
    ],
    "client": [
      "com.bawnorton.trulyrandom.client.TrulyRandomClient"
    ],
    "fabric-datagen": [
      "com.bawnorton.trulyrandom.data.TrulyRandomDataGenerator"
    ]
  },
  "mixins": [
    "trulyrandom.mixins.json",
    {
      "config": "trulyrandom.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "trulyrandom.accesswidener",
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.21",
    "java": ">=17",
    "fabric-api": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1657": ["com/bawnorton/trulyrandom/extend/TeamMember"]
    }
  }
}